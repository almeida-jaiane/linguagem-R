sin(30)                  # retorna o seno
tan(30)                  # retorna a tangente
log(2)                   # retorna o logaritmo natural
log10(10)                # retorna o logaritmo na base 10
exp(3)                   # retorna o valor exponencial
max(x)                   # retorna o maior nº de um vetor
min(x)                   # retorna o menor nº de um vetor
mean(x)                  # retorna a média de um vetor
sd(x)                    # retorna o desvio padrão de um vetor


# Chamada de Funções de Texto

substr('Meu primeiro exemplo', start=3, stop=10) # retorna o texto contido em x, da posição n1 até n2
grep('a', c('banana', 'coco', 'pera', 'uva') , ignore.case=FALSE, fixed=FALSE) # procura o padrão em x e retorna os índices correspondentes. Se fixed = FALSE, o padrão é uma expressão regular. Se fixed = TRUE, o padrão é uma sequência de caracteres
sub('a', 'x', 'uva', ignore.case=FALSE, fixed=TRUE) # procura o padrão em x e o substitui pelo texto de substituição . Se fixed = FALSE, o padrão é uma expressão regular. Se fixed = TRUE, o padrão é uma sequência de texto
gsub('a', 'x', 'banana', ignore.case=FALSE, fixed=TRUE) # substitui todas as correspondências de uma sequência, se o parâmetro for um vetor de sequência, retorna um vetor de sequência com o mesmo comprimento e com os mesmos atributos (após possível substituição com o caractere).
strsplit('banana', 'a') # divide os elementos de x em um vetor pelo texto contido em a posição split
paste('pera', 'uva', sep=' - ') # concatena texto e adiciona separador
toupper('banana') # transforma em maiúsculas
tolower('BANANA') # transforma em minúsculas
nchar('banana') # retorna a quantidade de caracteres


